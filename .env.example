# ----------------------------------------------------------------------------
# Tacynt Bet - Variables d'environnement
# Copier ce fichier en .env (racine, ou dans apps/api et apps/web selon besoin)
# Ne JAMAIS committer un fichier .env contenant de vraies valeurs.
# ----------------------------------------------------------------------------

# --- Backend (apps/api) ---
MONGODB_URI=mongodb://localhost:27017/tacynt-bet
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# SMTP optionnel : sans ces variables, l'envoi d'email (mot de passe oublie) est simplement
# desactive (le serveur demarre quand meme, voir services/email/mailer.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Frontend (apps/web) ---
# Seule variable exposee au navigateur : jamais de secret ici.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
